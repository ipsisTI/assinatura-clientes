# ===== Google Sheets =====
# ID da planilha de destino (copie da URL da planilha entre /d/ e /edit)
GOOGLE_SHEET_ID=
# Caminho do JSON de credenciais da Service Account, relativo à raiz do projeto
GOOGLE_CREDENTIALS_PATH=src/config/credentials.json

# ===== Google Drive =====
# ID da pasta de destino dos PDFs assinados (ou ID do Shared Drive, quando começar com 0A)
GOOGLE_DRIVE_FOLDER_ID=

# ===== Google reCAPTCHA v3 =====
# Cadastre o domínio em https://www.google.com/recaptcha/admin e cole as chaves abaixo
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ===== Aplicação =====
# Ambiente: production ou development
APP_ENV=production
# Exibir erros detalhados (use apenas em desenvolvimento)
APP_DEBUG=false
# URL pública da aplicação (usada em links e na validação de hostname do reCAPTCHA)
APP_URL=https://seu-dominio.com.br

# ===== Upload =====
# Tamanho máximo de arquivo em bytes (5 MB)
MAX_FILE_SIZE=5242880
# Extensões permitidas no upload, separadas por vírgula
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx

# ===== Segurança =====
# Tempo de vida da sessão em minutos
SESSION_LIFETIME=120
